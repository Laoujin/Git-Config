# Normalize all text files to LF in the repo and in the working tree.
# Both Windows and WSL must have core.autocrlf=false for this to stay stable
# across shared /mnt/c checkouts.
* text=auto eol=lf

# Files that genuinely need CRLF on Windows.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf

# This file is not synced

# Copy it manually to %USERPROFILE%
# (or beter yet, configure dotfiles to do this...)

# Or run these:
# git config --global user.name ""
# git config --global user.email ""
# git config --global include.path "~/.common.gitconfig"

[user]
	email = woutervs@hotmail.com
	name = Laoujin

# Windows style path:
# path = c:\\users\\username\\.common.gitconfig
[include]
	path = ~/.common.gitconfig

# Platform specific
[includeIf "gitdir/i:C:/"]
	path = ~/.windows.gitconfig

[includeIf "gitdir:/"]
	path = ~/.linux.gitconfig

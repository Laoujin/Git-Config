# Windows style path:
# path = c:\\users\\username\\.common.gitconfig
[include]
	path = ~/.common.gitconfig

# Platform specific
[includeIf "gitdir/i:C:/"]
	path = ~/.windows.gitconfig

[includeIf "gitdir:/"]
	path = ~/.linux.gitconfig
[credential "https://192.168.200.97"]
	provider = generic
